  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 187489523}
  bossObject: {fileID: 1995745187}
  bossSpawnPos: {fileID: 3610916906961943805}
  mainCamera: {fileID: 2061552614}
  playerMovementScript: {fileID: 841215362383593744}
  worldGUI: {fileID: 497129725}
  typingText: {fileID: 841215362383593743}
  initialDialogue:
    npcName: Umi Ida Ira Iva An
    sentences:
    - Vorrak, the stone gatekeeper.
    - Once a symbol of unwavering resolve, he is now nothing but a mass of hatred.
    - Use words to break through his defenses!
    - He is the only one left between you and peace!
  bossDialogue:
    npcName: Vorrak
    sentences:
    - Bearer of the Book... You have been deceived.
    - The path you are treading leads not to salvation, but to destruction.
    - I am the last line of defense. I will not fall!
  dialogueMusic: {fileID: 8300000, guid: d80eb7a77cbff6c49a9faae6c414b539, type: 3}
  teleportPos: {x: 0, y: -11}
  OnCombatStart:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 3610916906961943806}
        m_TargetAssemblyTypeName: VorrakController, Assembly-CSharp
        m_MethodName: BeginCombatPhase
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 3610916906961943807}
        m_TargetAssemblyTypeName: VorrakMovement, Assembly-CSharp
        m_MethodName: BeginMovementPhase
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  deathDialogue:
    npcName: Vorrak
    sentences:
    - The final seal...
    - has been broken...
    - 'Now... '
    - the choice is yours...
  OnBossPerish:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 3610916906961943812}
        m_TargetAssemblyTypeName: EnemyReceiveDamage, Assembly-CSharp
        m_MethodName: DesTroyBoss
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  postDeathDialogue:
    npcName: Umi Ida Ira Iva An
    sentences:
    - 'Excellent! You''ve completed the mission! '
    - 'All your powers have been restored! '
    - 'Now, we can return. '
    - The Library is safe!
  bossFragment:
    fragmentName: Fragment of Steadfastness
    fragmentSprite: {fileID: 8003496568946651819, guid: e142132d92c179e419518e29d2102381, type: 3}
