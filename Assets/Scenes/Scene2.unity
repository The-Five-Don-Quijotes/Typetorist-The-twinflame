          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  deathDialogue:
    npcName: 'Zhavok '
    sentences:
    - The second chain...
    - is gone...
    - You...
    - are paving the way...
  OnBossPerish:
    m_PersistentCalls:
      m_Calls: []
  postDeathDialogue:
    npcName: Umi Ida Ira Iva An
    sentences:
    - Excellent! The "Deception Fragment" is now in your hands!
    - 'Only Vorrak remains. '
    - He's the final obstacle!
  bossFragment:
    fragmentName: Fragment of Deception
    fragmentSprite: {fileID: -1525274468425128736, guid: 96b3a0358df25944e828dbdda8d04764, type: 3}
