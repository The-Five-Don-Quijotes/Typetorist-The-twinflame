  typingText: {fileID: 234231272}
  initialDialogue:
    npcName: Umi Ida Ira Iva An
    sentences:
    - Zhavok, the God of Deception.
    - He sows dismay and despair.
    - Beware of the souls he summons,
    - they will steal what is most precious to you!
  bossDialogue:
    npcName: Zhavok
    sentences:
    - The Heir... You have gone too far.
    - Every thing you take down is a broken link.
    - You're not saving the world, you're ending it.
  dialogueMusic: {fileID: 8300000, guid: a33fcb4de86726244a68637358db4cb3, type: 3}
  defaultSceneMusic: {fileID: 8300000, guid: 6404c26a11f3664469c6e88f8639d905, type: 3}
